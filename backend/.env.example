# Backend-only Supabase credentials. Use the service-role/secret key only here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
SUPABASE_STORAGE_BUCKET=certificates

# Comma-separated exact frontend origins. For production, include your Vercel
# production domain and any preview domains that need to call this API.
FRONTEND_ORIGINS=http://localhost:5173

# Supabase Auth user UUIDs allowed to access institution-wide certificate rows
# through the backend's service-role client. Leave empty to deny these routes.
ERP_CERTIFICATE_ADMIN_USER_IDS=

# OCR runtime; Docker provides the executable and English/Tamil trained data.
TESSERACT_CMD=/usr/bin/tesseract
OCR_LANGUAGES=eng+tam

# Optional AI assistant service configuration.
OLLAMA_URL=https://YOUR_OLLAMA_HOST/api/chat
OLLAMA_MODEL=llama3.2
ERP_LOOKUP_ALLOWED_USER_IDS=
